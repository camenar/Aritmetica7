function stripBase(){
  const W=800,H=120,x0=60,sW=640,sH=56;
  let s='<svg viewBox="0 0 '+W+' '+H+'" class="strip-svg" xmlns="http://www.w3.org/2000/svg">';
  // full kilo bar
  s+='<rect x="'+x0+'" y="30" width="'+sW+'" height="'+sH+'" fill="#E8E8E8" stroke="#999" stroke-width="1.5" rx="5"/>';
  // quarter marks (thick) + labels
  for(let i=0;i<=4;i++){
    const x=x0+sW*i/4;
    s+='<line x1="'+x+'" y1="28" x2="'+x+'" y2="'+(32+sH)+'" stroke="#666" stroke-width="2"/>';
    const labels=['0','¼','½','¾','1 kg'];
    s+='<text x="'+x+'" y="'+(36+sH+18)+'" text-anchor="middle" font-size="16" font-weight="700" fill="#333">'+labels[i]+'</text>';
  }
  // highlight 3/4 with strong fill
  const w34=sW*3/4;
  s+='<rect x="'+x0+'" y="30" width="'+w34+'" height="'+sH+'" fill="rgba(0,105,92,.25)" stroke="#00695C" stroke-width="3" rx="5"/>';
  // label ¾
  s+='<text x="'+(x0+w34/2)+'" y="22" text-anchor="middle" font-size="20" font-weight="800" fill="#00695C">¾ de kilo de arequipe</text>';
  // bracket below ¾
  const bY=36+sH+36;
  s+='<line x1="'+x0+'" y1="'+bY+'" x2="'+(x0+w34)+'" y2="'+bY+'" stroke="#00695C" stroke-width="2"/>';
  s+='<line x1="'+x0+'" y1="'+(bY-4)+'" x2="'+x0+'" y2="'+(bY+4)+'" stroke="#00695C" stroke-width="2"/>';
  s+='<line x1="'+(x0+w34)+'" y1="'+(bY-4)+'" x2="'+(x0+w34)+'" y2="'+(bY+4)+'" stroke="#00695C" stroke-width="2"/>';
  // gray zone for unused ¼
  s+='<rect x="'+(x0+w34)+'" y="30" width="'+(sW-w34)+'" height="'+sH+'" fill="rgba(0,0,0,.06)" rx="0 5 5 0"/>';
  s+='<text x="'+(x0+w34+sW/8)+'" y="'+(30+sH/2+6)+'" text-anchor="middle" font-size="14" fill="#999" font-style="italic">sobra</text>';
  s+='</svg>';return s;
}

function stripOctavos(){
  const W=800,H=160,x0=60,sW=640,sH=56;
  let s='<svg viewBox="0 0 '+W+' '+H+'" class="strip-svg" xmlns="http://www.w3.org/2000/svg">';
  // full kilo bar (lighter)
  s+='<rect x="'+x0+'" y="18" width="'+sW+'" height="'+sH+'" fill="#F0F0F0" stroke="#CCC" rx="5"/>';
  // 3/4 shaded
  const w34=sW*3/4;
  s+='<rect x="'+x0+'" y="18" width="'+w34+'" height="'+sH+'" fill="rgba(0,105,92,.12)" stroke="#00695C" stroke-width="2" rx="5"/>';
  // eighth lines inside ¾
  for(let i=0;i<=6;i++){
    const x=x0+sW*i/8;
    s+='<line x1="'+x+'" y1="18" x2="'+x+'" y2="'+(18+sH)+'" stroke="'+(i<=6?'#00695C':'#CCC')+'" stroke-width="1" stroke-dasharray="4 3"/>';
  }
  // 6 orange pieces below
  const pw=sW/8,y2=18+sH+22;
  for(let i=0;i<6;i++){
    const px=x0+i*pw;
    s+='<rect x="'+px+'" y="'+y2+'" width="'+(pw-4)+'" height="42" fill="rgba(251,133,0,.25)" stroke="#FB8500" stroke-width="2.5" rx="5"/>';
    s+='<text x="'+(px+pw/2-2)+'" y="'+(y2+28)+'" text-anchor="middle" font-size="18" font-weight="800" fill="#FB8500">'+(i+1)+'</text>';
    // arrow from piece up to strip
    const cx=px+pw/2-2;
    s+='<line x1="'+cx+'" y1="'+y2+'" x2="'+cx+'" y2="'+(18+sH)+'" stroke="#FB8500" stroke-width="1" stroke-dasharray="3 3" opacity=".5"/>';
  }
  s+='<text x="'+(x0+6*pw+16)+'" y="'+(y2+28)+'" font-size="18" font-weight="800" fill="#FB8500">= 6 frascos de ⅛</text>';
  s+='</svg>';return s;
}

