<script>
function announceToScreenReader(msg){const r=document.getElementById('live-region');if(r){r.textContent='';setTimeout(()=>{r.textContent=msg;},100);}}
function showFeedback(msg,isError=false){const fb=document.getElementById('feedback');if(!fb)return;fb.textContent=msg;fb.className='feedback-msg'+(isError?' error':'')+' show';setTimeout(()=>fb.classList.remove('show'),3200);}
function saveProgress(idx,cl){try{localStorage.setItem('s10_arit7',JSON.stringify({slide:idx,clicks:cl,ts:Date.now()}));}catch(e){}}
