<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
<title>Aritmética 7° · Sem. 10 · División de fracciones · I.E. Merceditas Gómez Martínez</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#023047;--blue:#219EBC;--blue-mid:#219EBC;
  --green:#2E7D32;--teal:#00695C;--amber:#FFB703;--red:#B71C1C;
  --green-b:#27AE60;--amber-b:#FB8500;--red-b:#C0392B;
  --cream:#F7F6F2;--warm:#EDECEA;--border:#C0BDB4;
  --text:#1C1C1E;--text2:#3A3A3C;--text3:#6B6B6E;
  --sky:#8ECAE6;
  --fs-xs:clamp(18px,1.25vw,26px);
  --fs-sm:clamp(22px,1.6vw,32px);
  --fs-md:clamp(26px,2vw,40px);
  --fs-lg:clamp(32px,2.6vw,50px);
  --fs-xl:clamp(38px,3.2vw,62px);
  --fs-2xl:clamp(48px,4.2vw,80px);
  --fs-3xl:clamp(60px,5.8vw,105px);
  --gap:clamp(14px,1.6vw,22px);
  --pad:clamp(20px,2.8vw,40px);
  --line-h:1.55;
}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
html,body{width:100%;height:100%;overflow:hidden;background:#0a101e;font-family:'DM Sans',system-ui,sans-serif;line-height:var(--line-h)}
#deck{width:100vw;height:100vh;position:relative;overflow:hidden}
.slide{position:absolute;inset:0;display:flex;flex-direction:column;opacity:0;pointer-events:none;background:var(--cream)}
.slide.active{opacity:1;pointer-events:all}
.slide.enter-r{animation:inR .32s cubic-bezier(.22,.68,0,1.1) forwards}
.slide.enter-l{animation:inL .32s cubic-bezier(.22,.68,0,1.1) forwards}
@keyframes inR{from{transform:translateX(3.5%);opacity:0}to{transform:none;opacity:1}}
@keyframes inL{from{transform:translateX(-3.5%);opacity:0}to{transform:none;opacity:1}}
@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
header.hdr{background:var(--navy);height:clamp(44px,5.2vh,60px);display:flex;align-items:center;padding:0 var(--pad);justify-content:space-between;flex-shrink:0}
.hdr-b{font-size:var(--fs-xs);font-weight:500;color:var(--sky);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hdr-badge{background:var(--blue);color:#fff;font-size:var(--fs-xs);font-weight:800;padding:6px clamp(12px,1.8vw,22px);border-radius:6px;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;flex-shrink:0;margin-left:14px}
footer.ftr{background:var(--warm);border-top:2px solid var(--border);height:clamp(36px,4vh,48px);display:flex;align-items:center;padding:0 var(--pad);justify-content:space-between;flex-shrink:0}
.ftr span{font-size:var(--fs-xs);color:var(--text3);font-weight:500}
main.body{flex:1;overflow-y:auto;overflow-x:hidden;min-height:0;scroll-behavior:smooth;padding:clamp(16px,2.2vh,28px) var(--pad) clamp(12px,1.5vh,20px);display:flex;flex-direction:column;gap:var(--gap)}
main.body::-webkit-scrollbar{width:6px}
main.body::-webkit-scrollbar-thumb{background:rgba(0,0,0,.15);border-radius:3px}
.s-portada{background:var(--blue)}
.portada-inner{width:100%;max-width:1400px;margin:0 auto;padding:clamp(28px,5vh,60px) clamp(40px,6vw,80px);display:flex;flex-direction:column;gap:clamp(14px,2.4vh,26px)}
.p-ie{font-size:var(--fs-sm);color:rgba(180,210,240,.85);text-align:center;letter-spacing:.05em}
.p-area{font-size:var(--fs-sm);font-weight:700;color:rgba(180,210,240,.95);text-align:center;letter-spacing:.16em;text-transform:uppercase}
.p-title{font-family:'DM Serif Display',serif;font-size:var(--fs-3xl);color:#fff;text-align:center;line-height:1.05;animation:fadeUp .9s .1s both}
.p-sub{font-size:var(--fs-xl);color:rgba(200,228,255,.9);text-align:center;font-style:italic;animation:fadeUp .9s .25s both}
.p-divider{height:3px;background:rgba(255,255,255,.25);border-radius:2px;margin:clamp(6px,1.2vh,12px) 0}
.p-card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(10px,1.2vw,18px);animation:fadeUp .9s .4s both}
.p-card{background:rgba(255,255,255,.09);border:2px solid rgba(255,255,255,.18);border-radius:14px;padding:clamp(14px,1.8vh,24px) clamp(12px,1.5vw,20px);display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center}
.p-card-num{width:clamp(44px,4.6vw,60px);height:clamp(44px,4.6vw,60px);border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:var(--fs-lg);font-weight:700;color:#fff}
.p-card-title{font-size:var(--fs-md);font-weight:700;color:#fff;line-height:1.15}
.p-card-sub{font-size:var(--fs-sm);color:rgba(200,228,255,.8);font-style:italic;line-height:1.4}
.p-docente{font-size:var(--fs-sm);color:rgba(180,210,240,.7);text-align:right;font-style:italic}
.s-sesion{background:var(--navy)}
.sesion-inner{display:flex;height:100%;width:100%}
.sesion-num{width:clamp(160px,18vw,260px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;flex-shrink:0}
.sesion-num-lbl{font-size:var(--fs-sm);color:var(--sky);text-transform:uppercase;letter-spacing:.16em;font-weight:700}
.sesion-num-big{font-size:clamp(100px,14vw,200px);font-weight:800;color:#fff;line-height:1}
.sesion-right{flex:1;display:flex;flex-direction:column;justify-content:center;padding:clamp(32px,5vh,70px) clamp(32px,4vw,70px);gap:clamp(14px,2vh,24px)}
.sesion-tag{font-size:var(--fs-sm);font-weight:800;color:var(--sky);text-transform:uppercase;letter-spacing:.18em}
.sesion-title{font-family:'DM Serif Display',serif;font-size:var(--fs-2xl);color:#fff;line-height:1.08}
.sesion-sub{font-size:var(--fs-md);color:rgba(200,228,255,.75);font-style:italic;line-height:1.45}
.sesion-chips{display:flex;flex-wrap:wrap;gap:12px;margin-top:8px}
.sesion-chip{background:rgba(255,255,255,.1);border:1.5px solid rgba(255,255,255,.2);border-radius:24px;padding:8px 20px;font-size:var(--fs-xs);color:var(--sky);font-weight:600}
.title-row{display:flex;align-items:flex-start;gap:16px}
.accent-bar{width:clamp(10px,1vw,14px);border-radius:6px;flex-shrink:0;align-self:stretch;min-height:48px}
.slide-title{font-family:'DM Serif Display',serif;font-size:var(--fs-xl);color:var(--navy);line-height:1.08}
.slide-instr{font-size:var(--fs-md);color:var(--text2);font-style:italic;margin-top:6px;line-height:1.4}
.badge{display:inline-flex;align-items:center;font-size:var(--fs-sm);font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:6px 16px;border-radius:6px;margin-bottom:4px}
.det-box{background:#FFF8ED;border:3px solid var(--amber-b);border-radius:14px;padding:clamp(16px,2vh,24px) clamp(18px,2.2vw,30px);display:flex;flex-direction:column;gap:clamp(10px,1.4vh,16px)}
.det-label{font-size:var(--fs-sm);font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--amber-b)}
.det-text{font-family:'DM Serif Display',serif;font-size:var(--fs-lg);color:var(--text);line-height:1.55;font-style:italic}
.det-q{font-size:var(--fs-xl);font-weight:800;color:var(--navy);line-height:1.35}
.activacion-previa{background:var(--warm);border-left:5px solid var(--blue);border-radius:0 10px 10px 0;padding:clamp(12px,1.4vh,20px) clamp(14px,1.8vw,26px);font-size:var(--fs-md);color:var(--text2);font-style:italic}
.activacion-previa strong{color:var(--navy);font-style:normal}
.paso-row{display:flex;align-items:center;gap:clamp(12px,1.4vw,20px);background:#fff;border:2px solid var(--border);border-radius:12px;padding:clamp(10px,1.2vh,18px) clamp(14px,1.8vw,24px);border-left:6px solid var(--blue);opacity:0;transform:translateY(14px);transition:opacity .4s,transform .4s}
.paso-row.vis{opacity:1;transform:none}
.paso-num{width:clamp(30px,3.2vw,46px);height:clamp(30px,3.2vw,46px);border-radius:50%;background:var(--blue);display:flex;align-items:center;justify-content:center;font-size:var(--fs-md);font-weight:800;color:#fff;flex-shrink:0}
.paso-lbl{font-size:var(--fs-sm);font-weight:800;color:var(--blue);flex-shrink:0;min-width:clamp(100px,11vw,150px)}
.paso-body{font-size:var(--fs-md);color:var(--text);flex:1;line-height:1.4}
.result-bar{background:var(--navy);border-radius:12px;padding:clamp(12px,1.6vh,22px) clamp(16px,2vw,28px);display:flex;align-items:center;justify-content:center;gap:20px;font-size:var(--fs-xl);font-weight:800;color:var(--amber);text-align:center;white-space:nowrap;overflow-x:auto;opacity:0;transform:translateY(12px);transition:opacity .4s,transform .4s}
.result-bar.vis{opacity:1;transform:none}
.formal-box{background:var(--warm);border:3px solid var(--green);border-radius:14px;padding:clamp(14px,1.8vh,26px) clamp(16px,2vw,30px);display:flex;flex-direction:column;gap:clamp(12px,1.6vh,20px);align-items:stretch}
.formal-title{font-size:var(--fs-lg);font-weight:800;color:var(--green);text-align:center}
.formal-step{background:#fff;border:2px solid var(--border);border-radius:10px;padding:clamp(10px,1.2vh,18px) clamp(14px,1.8vw,22px);display:flex;align-items:center;gap:14px;width:100%;opacity:0;transition:opacity .4s}
.formal-step.vis{opacity:1}
.formal-step-n{width:clamp(30px,3.2vw,44px);height:clamp(30px,3.2vw,44px);border-radius:50%;background:var(--green);display:flex;align-items:center;justify-content:center;font-size:var(--fs-md);font-weight:800;color:#fff;flex-shrink:0}
.formal-step-txt{font-size:var(--fs-md);color:var(--text);line-height:1.4;flex:1}
.conj-box{background:#E8F5E9;border:3px solid var(--green);border-radius:12px;padding:clamp(12px,1.4vh,20px) clamp(14px,1.8vw,22px);font-size:var(--fs-md);color:var(--green);font-style:italic;line-height:1.5}
.cards-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:clamp(10px,1vw,16px)}
.ex-card{background:#fff;border-radius:14px;border:2.5px solid var(--border);border-top:6px solid transparent;padding:clamp(12px,1.6vh,20px) clamp(12px,1.6vw,20px);display:flex;flex-direction:column;gap:clamp(8px,1vh,12px);opacity:0;transform:translateY(16px);transition:opacity .45s,transform .45s}
.ex-card.vis{opacity:1;transform:none}
.ex-head{display:flex;align-items:center;gap:12px}
.ex-num{width:clamp(30px,3.2vw,46px);height:clamp(30px,3.2vw,46px);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:var(--fs-md);color:#fff;flex-shrink:0}
.ex-title{font-size:var(--fs-md);font-weight:800;color:var(--text)}
.ex-ctx{font-size:var(--fs-sm);color:var(--text2);font-style:italic;line-height:1.4}
.ex-task{background:var(--warm);border-radius:10px;padding:clamp(10px,1.2vh,16px) clamp(12px,1.5vw,18px);font-size:var(--fs-lg);font-weight:800;color:var(--navy);text-align:center;border:2px solid var(--border)}
.error-box{background:#FFF0F0;border:3px solid var(--red);border-radius:14px;padding:clamp(14px,1.8vh,22px) clamp(16px,2vw,26px);display:flex;flex-direction:column;gap:clamp(8px,1vh,12px)}
.error-title{font-size:var(--fs-md);font-weight:800;color:var(--red)}
.error-txt{font-size:var(--fs-sm);color:var(--text);line-height:1.55}
.metodo-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--gap)}
.metodo-card{border-radius:14px;padding:clamp(14px,1.8vh,24px) clamp(14px,1.8vw,22px);display:flex;flex-direction:column;gap:12px;opacity:0;transform:translateY(14px);transition:opacity .4s,transform .4s}
.metodo-card.vis{opacity:1;transform:none}
.metodo-card.mal{background:#FFF0F0;border:3px solid var(--red)}
.metodo-card.bien{background:#E8F5E9;border:3px solid var(--green)}
.metodo-lbl{font-size:var(--fs-sm);font-weight:800;letter-spacing:.1em;text-transform:uppercase}
.metodo-card.mal .metodo-lbl{color:var(--red)}
.metodo-card.bien .metodo-lbl{color:var(--green)}
.metodo-body{font-size:var(--fs-md);color:var(--text);line-height:1.5}
.info-box{background:#EBF4FB;border-left:5px solid var(--blue);border-radius:0 12px 12px 0;padding:clamp(12px,1.4vh,20px) clamp(14px,1.8vw,24px);font-size:var(--fs-md);color:var(--text2);line-height:1.6}
.info-box strong{color:var(--navy);font-style:normal}
.piar-box{background:#F3E5F5;border:2.5px solid #6A1B9A;border-radius:10px;padding:clamp(10px,1.2vh,16px) clamp(12px,1.5vw,20px);font-size:var(--fs-xs);color:#4A148C;line-height:1.6;margin-top:var(--gap)}
.piar-lbl{font-weight:800;text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:6px}
.meta-q{background:#E0F2F1;border:3px solid var(--teal);border-radius:14px;padding:clamp(14px,1.8vh,24px) clamp(16px,2vw,28px)}
.meta-qlbl{font-size:var(--fs-xs);font-weight:800;color:var(--teal);text-transform:uppercase;letter-spacing:.12em;margin-bottom:10px}
.meta-qtxt{font-family:'DM Serif Display',serif;font-size:var(--fs-xl);color:var(--text);font-style:italic;line-height:1.55}
.semaforo{display:flex;flex-direction:column;gap:clamp(10px,1.2vh,18px)}
.sema-item{display:flex;align-items:flex-start;gap:16px;background:#fff;border-radius:12px;padding:clamp(12px,1.6vh,20px) clamp(14px,1.8vw,24px);border:2.5px solid var(--border);opacity:0;transform:translateX(16px);transition:opacity .45s,transform .45s}
.sema-item.vis{opacity:1;transform:none}
.sema-circle{width:clamp(46px,5vw,68px);height:clamp(46px,5vw,68px);border-radius:50%;flex-shrink:0}
.sema-txt{font-size:var(--fs-md);color:var(--text);line-height:1.35}
.sema-sub{display:block;font-size:var(--fs-sm);color:var(--text3);margin-top:4px;font-style:italic}
.mcm-table{width:100%;border-collapse:collapse;font-size:var(--fs-sm)}
.mcm-table th{background:var(--navy);color:#fff;padding:clamp(8px,1vh,14px) clamp(10px,1.2vw,18px);text-align:center}
.mcm-table td{padding:clamp(8px,1vh,14px) clamp(10px,1.2vw,18px);border-bottom:2px solid var(--border);text-align:center;font-size:var(--fs-md);color:var(--text)}
.mcm-table tr:nth-child(even) td{background:#fff}
.mcm-table tr:nth-child(odd) td{background:var(--warm)}
.mcm-table .hi{background:#FFF9C4!important;font-weight:800;color:var(--amber-b)}
.espacio-respuesta{background:#fff;border:2.5px dashed var(--border);border-radius:10px;padding:clamp(10px,1.2vh,16px) clamp(12px,1.5vw,20px);font-size:var(--fs-md);color:var(--text);min-height:clamp(70px,9vh,110px);margin:var(--gap) 0;font-style:italic}
.espacio-respuesta:focus{border-color:var(--blue);outline:none;box-shadow:0 0 0 4px rgba(33,158,188,.25)}
.btn-exportar{background:var(--green-b);color:#fff;border:none;padding:10px 22px;border-radius:8px;font-weight:700;cursor:pointer;margin-top:12px;font-size:var(--fs-sm);display:inline-flex;align-items:center;gap:8px}
.btn-exportar:hover{background:var(--green)}
.feedback-msg{position:fixed;top:clamp(70px,9vh,90px);left:50%;transform:translateX(-50%);background:var(--green);color:#fff;padding:12px 24px;border-radius:10px;font-size:var(--fs-sm);font-weight:600;box-shadow:0 6px 16px rgba(0,0,0,.25);z-index:300;opacity:0;transition:opacity .3s;pointer-events:none;max-width:90vw;text-align:center}
.feedback-msg.error{background:var(--red-b)}
.feedback-msg.show{opacity:1}
#fs-btn{position:fixed;top:clamp(10px,1.2vh,16px);right:clamp(76px,8.5vw,100px);z-index:200;background:rgba(2,48,71,.8);border:2px solid rgba(255,255,255,.25);color:#fff;cursor:pointer;font-size:18px;width:42px;height:42px;border-radius:8px;display:flex;align-items:center;justify-content:center;transition:background .2s}
#fs-btn:hover{background:var(--blue)}
#nav{position:fixed;bottom:clamp(16px,2.2vh,26px);right:clamp(20px,2.8vw,34px);display:flex;align-items:center;gap:clamp(10px,1.2vw,16px);z-index:100}
.nbtn{width:clamp(46px,5vw,62px);height:clamp(46px,5vw,62px);border-radius:50%;background:rgba(2,48,71,.9);border:2px solid rgba(255,255,255,.2);color:#fff;cursor:pointer;font-size:clamp(20px,2.4vw,28px);display:flex;align-items:center;justify-content:center;transition:background .2s}
.nbtn:hover{background:var(--blue)}
#ncnt{font-size:clamp(15px,1.6vw,20px);color:rgba(255,255,255,.9);background:rgba(2,48,71,.85);padding:clamp(6px,.8vh,10px) clamp(14px,1.8vw,22px);border-radius:24px;font-family:monospace;font-weight:700}
#pbar{position:fixed;bottom:0;left:0;height:5px;background:var(--blue);transition:width .32s ease;z-index:100}
#hint{position:fixed;bottom:clamp(16px,2.2vh,26px);left:clamp(20px,2.8vw,34px);font-size:14px;color:rgba(255,255,255,.55);background:rgba(2,48,71,.75);padding:8px 16px;border-radius:24px;font-family:monospace;transition:opacity .3s;z-index:100}
.katex{font-size:1.15em!important}
.katex-display{margin:0!important}
.rv{opacity:0;transition:opacity .45s}
.rv.vis{opacity:1}
.pill{display:inline-block;background:var(--warm);border:2px solid var(--border);border-radius:8px;padding:4px 12px;font-size:var(--fs-sm);font-weight:700;color:var(--navy)}
.vote-wrap{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--gap)}
.vote-card{background:#fff;border-radius:14px;border:2.5px solid var(--border);padding:clamp(12px,1.6vh,20px) clamp(12px,1.6vw,20px);display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;opacity:0;transform:translateY(14px);transition:opacity .4s,transform .4s}
.vote-card.vis{opacity:1;transform:none}
.vote-person{font-size:var(--fs-lg);font-weight:800;color:var(--navy)}
.vote-claim{font-family:'DM Serif Display',serif;font-size:var(--fs-sm);color:var(--text2);font-style:italic;line-height:1.45}
.vote-verdict{font-size:var(--fs-sm);font-weight:800;padding:6px 16px;border-radius:8px;margin-top:6px}
.decision-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--gap)}
.decision-card{background:#fff;border-radius:14px;border:2.5px solid var(--border);padding:clamp(14px,1.8vh,24px) clamp(14px,1.8vw,22px);display:flex;flex-direction:column;gap:10px;opacity:0;transform:translateY(14px);transition:opacity .4s,transform .4s}
.decision-card.vis{opacity:1;transform:none}
.decision-title{font-size:var(--fs-md);font-weight:800}
.decision-detail{font-size:var(--fs-sm);color:var(--text2);line-height:1.4}
.decision-result{background:var(--warm);border:2px solid var(--border);border-radius:10px;padding:10px 14px;font-size:var(--fs-lg);font-weight:800;color:var(--navy);text-align:center}
