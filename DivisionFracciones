let cur=0,clicks=0;
const deck=document.getElementById('deck');
const saved=loadProgress();
if(saved){cur=saved.slide||0;clicks=0;}

function doKatex(el){
  if(window.renderMathInElement){
    renderMathInElement(el,{delimiters:[{left:'\\(',right:'\\)',display:false},{left:'\\[',right:'\\]',display:true}],throwOnError:false,strict:false});
  }
}

function buildSlide(idx){
  const s=SLIDES[idx];const d=document.createElement('div');
  d.className='slide'+(s.cls?' '+s.cls:'');d.setAttribute('role','region');d.setAttribute('aria-label','Diapositiva '+(idx+1)+' de '+SLIDES.length);
  let h='';
  if(!s.noH){const bc=s.badgeColor||'var(--blue)';h+='<header class="hdr"><span class="hdr-b">'+(s.bread||'')+'</span>'+(s.badge?'<span class="hdr-badge" style="background:'+bc+'">'+s.badge+'</span>':'')+'</header>';}
  h+='<main class="body">'+s.html+'</main>';
  if(!s.noF) h+='<footer class="ftr"><span>'+(s.fL||'')+'</span><span>I.E. Merceditas Gómez Martínez · Aritmética 7°</span></footer>';
  d.innerHTML=h;return d;
}

function show(idx,dir){
  const prev=deck.querySelector('.slide.active');if(prev)prev.classList.remove('active','enter-r','enter-l');
  const el=buildSlide(idx);deck.appendChild(el);
  const all=deck.querySelectorAll('.slide');if(all.length>3)all[0].remove();
  requestAnimationFrame(()=>{el.classList.add('active',dir>=0?'enter-r':'enter-l');setTimeout(()=>el.classList.remove('enter-r','enter-l'),360);doKatex(el);const main=el.querySelector('main.body');if(main)main.scrollTop=0;const title=el.querySelector('.slide-title');announceToScreenReader(title?'Diapositiva '+(idx+1)+': '+title.textContent:'Diapositiva '+(idx+1)+' de '+SLIDES.length);});
  clicks=0;document.getElementById('ncnt').textContent=(idx+1)+' / '+SLIDES.length;
  document.getElementById('pbar').style.width=((idx+1)/SLIDES.length*100).toFixed(1)+'%';saveProgress(idx,0);
}

function advance(){
  const s=SLIDES[cur];const mx=s.clicks||0;
  if(clicks<mx){clicks++;const el=deck.querySelector('.slide.active');if(el){el.querySelectorAll('[data-c="'+clicks+'"]').forEach(e=>{e.classList.add('vis');e.style.opacity='1';});doKatex(el);}announceToScreenReader('Paso '+clicks+' de '+mx);saveProgress(cur,clicks);return;}
  if(cur<SLIDES.length-1){cur++;show(cur,1);}else showFeedback('¡Has completado la Semana 10! 🎉');
}
function retreat(){if(cur>0){cur--;show(cur,-1);}}

document.addEventListener('keydown',e=>{if(['Space','ArrowRight','ArrowLeft'].includes(e.code))e.preventDefault();if(e.code==='Space'||e.code==='ArrowRight')advance();if(e.code==='ArrowLeft')retreat();if(e.code==='KeyF')document.getElementById('fs-btn')?.click();});
document.getElementById('bn').addEventListener('click',advance);
document.getElementById('bp').addEventListener('click',retreat);
let tx=0;
document.addEventListener('touchstart',e=>{if(e.touches?.[0])tx=e.touches[0].clientX;},{passive:true});
document.addEventListener('touchend',e=>{const t=e.changedTouches?.[0];if(!t)return;const dx=t.clientX-tx;if(Math.abs(dx)>50){dx<0?advance():retreat();}});

const fsBtn=document.getElementById('fs-btn');
if(fsBtn){fsBtn.addEventListener('click',async()=>{try{if(!document.fullscreenElement)await document.documentElement.requestFullscreen();else await document.exitFullscreen();}catch(e){showFeedback('Pantalla completa no disponible',true);}});document.addEventListener('fullscreenchange',()=>{fsBtn.textContent=document.fullscreenElement?'✕':'⛶';});}

function exportarReflexion(){
  const espacios=[];document.querySelectorAll('.espacio-respuesta').forEach((el,i)=>{if(el.textContent.trim()&&el.textContent.trim()!=='Escribe tu reflexión aquí...')espacios.push('Reflexión '+(i+1)+': '+el.textContent.trim());});
  let contenido='EVIDENCIAS — Aritmética 7° — Semana 10\n'+new Date().toLocaleString('es-CO')+'\n\n';
  if(espacios.length)contenido+=espacios.join('\n\n---\n\n');
  try{const blob=new Blob([contenido],{type:'text/plain;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='arit7_s10_evidencias_'+new Date().toISOString().slice(0,10)+'.txt';document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(url);showFeedback('📥 Reflexiones guardadas');}catch(e){navigator.clipboard?.writeText(contenido);showFeedback('📋 Copiado al portapapeles');}
}

setTimeout(()=>{const h=document.getElementById('hint');if(h)h.style.opacity='0';},5000);
show(saved?.slide||0,1);
</script>
